From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Francesco Territo <fterrito@protonmail.com>
Date: Mon, 24 Aug 2026 18:00:00 +0200
Subject: [PATCH] sched/fair: boost wakeups after long uninterruptible sleeps

Record when a fair task enters uninterruptible sleep. If it wakes more
than one millisecond later, mark that wakeup for a one-shot virtual
runtime boost before the task is placed on the runqueue.

Subtract one weight-adjusted scheduler base slice from the task's
virtual runtime and clamp it to min_vruntime minus one virtual slice.
Handle tasks retained by EEVDF delayed dequeue by requeueing the entity
before changing its placement, so the deadline-ordered tree and its
augmented data remain consistent.

This mechanism detects a scheduling state and duration, not the cause
of the sleep. In particular, it does not identify block I/O directly.

Signed-off-by: Francesco Territo <fterrito@protonmail.com>
---
 linux-6.13.9/include/linux/sched.h |  4 ++
 linux-6.13.9/kernel/fork.c         |  4 ++
 linux-6.13.9/kernel/sched/fair.c   | 67 ++++++++++++++++++++++++++----
 3 files changed, 67 insertions(+), 8 deletions(-)

diff --git a/linux-6.13.9/include/linux/sched.h b/linux-6.13.9/include/linux/sched.h
index 376478d29..e4eb1c83b 100644
--- a/linux-6.13.9/include/linux/sched.h
+++ b/linux-6.13.9/include/linux/sched.h
@@ -870,6 +870,10 @@ struct task_struct {
 
 	struct sched_statistics         stats;
 
+	/* One-shot wakeup boost after a long uninterruptible sleep. */
+	u64				last_uninterruptible_sleep_start;
+	unsigned			wakeup_boost_pending:1;
+
 #ifdef CONFIG_PREEMPT_NOTIFIERS
 	/* List of struct preempt_notifier: */
 	struct hlist_head		preempt_notifiers;
diff --git a/linux-6.13.9/kernel/fork.c b/linux-6.13.9/kernel/fork.c
index 9da032802..9efa99078 100644
--- a/linux-6.13.9/kernel/fork.c
+++ b/linux-6.13.9/kernel/fork.c
@@ -2252,6 +2252,10 @@ __latent_entropy struct task_struct *copy_process(
 	if (args->name)
 		strscpy_pad(p->comm, args->name, sizeof(p->comm));
 
+	/* Do not inherit wakeup boost state from the parent. */
+	p->last_uninterruptible_sleep_start = 0;
+	p->wakeup_boost_pending = 0;
+
 	p->set_child_tid = (clone_flags & CLONE_CHILD_SETTID) ? args->child_tid : NULL;
 	/*
 	 * Clear TID on mm_release()?
diff --git a/linux-6.13.9/kernel/sched/fair.c b/linux-6.13.9/kernel/sched/fair.c
index 4f850edf1..71a58d9d2 100644
--- a/linux-6.13.9/kernel/sched/fair.c
+++ b/linux-6.13.9/kernel/sched/fair.c
@@ -5256,6 +5256,22 @@ place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 
 	se->vruntime = vruntime - lag;
 
+	/* Apply one bounded boost to the qualifying wakeup. */
+	if ((flags & ENQUEUE_WAKEUP) && entity_is_task(se)) {
+		struct task_struct *tsk = task_of(se);
+
+		if (tsk->wakeup_boost_pending) {
+			u64 boost = sysctl_sched_base_slice;
+			u64 floor = cfs_rq->min_vruntime - vslice;
+
+			se->vruntime -= calc_delta_fair(boost, se);
+
+			if ((s64)(se->vruntime - floor) < 0)
+				se->vruntime = floor;
+			tsk->wakeup_boost_pending = 0;
+		}
+	}
+
 	if (se->rel_deadline) {
 		se->deadline += se->vruntime;
 		se->rel_deadline = 0;
@@ -5282,7 +5298,7 @@ static inline int cfs_rq_throttled(struct cfs_rq *cfs_rq);
 static inline bool cfs_bandwidth_used(void);
 
 static void
-requeue_delayed_entity(struct sched_entity *se);
+requeue_delayed_entity(struct sched_entity *se, int flags);
 
 static void
 enqueue_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
@@ -6861,10 +6877,31 @@ static int sched_idle_cpu(int cpu)
 }
 #endif
 
+static void prepare_wakeup_boost(struct rq *rq, struct task_struct *p, int flags)
+{
+	s64 sleep_time;
+
+	if (!(flags & ENQUEUE_WAKEUP))
+		return;
+
+	p->wakeup_boost_pending = 0;
+	if (!p->last_uninterruptible_sleep_start)
+		return;
+
+	sleep_time = (s64)(rq_clock(rq) -
+			   p->last_uninterruptible_sleep_start);
+	p->last_uninterruptible_sleep_start = 0;
+
+	if (sleep_time > NSEC_PER_MSEC)
+		p->wakeup_boost_pending = 1;
+}
+
 static void
-requeue_delayed_entity(struct sched_entity *se)
+requeue_delayed_entity(struct sched_entity *se, int flags)
 {
 	struct cfs_rq *cfs_rq = cfs_rq_of(se);
+	bool wakeup_boost = (flags & ENQUEUE_WAKEUP) && entity_is_task(se) &&
+			    task_of(se)->wakeup_boost_pending;
 
 	/*
 	 * se->sched_delayed should imply: se->on_rq == 1.
@@ -6874,14 +6911,16 @@ requeue_delayed_entity(struct sched_entity *se)
 	SCHED_WARN_ON(!se->sched_delayed);
 	SCHED_WARN_ON(!se->on_rq);
 
-	if (sched_feat(DELAY_ZERO)) {
+	if (sched_feat(DELAY_ZERO) || wakeup_boost) {
 		update_entity_lag(cfs_rq, se);
-		if (se->vlag > 0) {
+		if (se->vlag > 0 || wakeup_boost) {
 			cfs_rq->nr_running--;
 			if (se != cfs_rq->curr)
 				__dequeue_entity(cfs_rq, se);
-			se->vlag = 0;
-			place_entity(cfs_rq, se, 0);
+			if (sched_feat(DELAY_ZERO) && se->vlag > 0)
+				se->vlag = 0;
+			place_entity(cfs_rq, se,
+				     wakeup_boost ? ENQUEUE_WAKEUP : 0);
 			if (se != cfs_rq->curr)
 				__enqueue_entity(cfs_rq, se);
 			cfs_rq->nr_running++;
@@ -6908,6 +6947,8 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 	int rq_h_nr_running = rq->cfs.h_nr_running;
 	u64 slice = 0;
 
+	prepare_wakeup_boost(rq, p, flags);
+
 	/*
 	 * The code below (indirectly) updates schedutil which looks at
 	 * the cfs_rq utilization to select a frequency.
@@ -6918,7 +6959,7 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		util_est_enqueue(&rq->cfs, p);
 
 	if (flags & ENQUEUE_DELAYED) {
-		requeue_delayed_entity(se);
+		requeue_delayed_entity(se, flags);
 		return;
 	}
 
@@ -6936,7 +6977,7 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 	for_each_sched_entity(se) {
 		if (se->on_rq) {
 			if (se->sched_delayed)
-				requeue_delayed_entity(se);
+				requeue_delayed_entity(se, flags);
 			break;
 		}
 		cfs_rq = cfs_rq_of(se);
@@ -7152,6 +7193,16 @@ static int dequeue_entities(struct rq *rq, struct sched_entity *se, int flags)
  */
 static bool dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 {
+	if (flags & DEQUEUE_SLEEP) {
+		unsigned int state = READ_ONCE(p->__state);
+
+		p->wakeup_boost_pending = 0;
+		if (state & TASK_UNINTERRUPTIBLE)
+			p->last_uninterruptible_sleep_start = rq_clock(rq);
+		else
+			p->last_uninterruptible_sleep_start = 0;
+	}
+
 	if (!(p->se.sched_delayed && (task_on_rq_migrating(p) || (flags & DEQUEUE_SAVE))))
 		util_est_dequeue(&rq->cfs, p);
 
-- 
2.43.0
